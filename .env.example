# Configure this on the server. Never place the API key in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
PORT=3000
# Set this on the API server when the frontend is hosted on GitHub Pages.
# Use the exact frontend origin, without a repository path.
ALLOWED_ORIGINS=https://ltwyz55-a11y.github.io
# For cloud server containers, use HOST=0.0.0.0; local default is 127.0.0.1.
